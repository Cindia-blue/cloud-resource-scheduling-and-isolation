# Ordinary control Pod for Phase 4 Test D: no schedulerName (uses the
# cluster default), no protection-intent annotation. Must be scheduled
# exactly as any other Pod always is -- proves the custom Filter plugin
# never processes or binds a Pod that didn't opt in.
apiVersion: v1
kind: Pod
metadata:
  name: "{{POD_NAME}}"
  namespace: "{{CAPABILITY_NAMESPACE}}"
  labels:
    app: ioi-capability-scheduler-test-control
spec:
  restartPolicy: Never
  activeDeadlineSeconds: 120
  containers:
    - name: inert
      image: busybox:1.36
      command: ["sleep", "100"]
