# Inert (no fio, no cgroup write) opted-in Pod for Phase 4
# plumbing-only testing. Deliberately has NO spec.nodeName and NO
# nodeAffinity/nodeSelector -- the whole point is to let
# ioi-capability-scheduler make the placement decision itself. A Pod
# pinned by nodeName would prove nothing about scheduler behavior (see
# docs/architecture.md's note on why the completed IOCost cells, which
# DO use nodeName, do not validate placement).
apiVersion: v1
kind: Pod
metadata:
  name: "{{POD_NAME}}"
  namespace: "{{CAPABILITY_NAMESPACE}}"
  labels:
    app: ioi-capability-scheduler-test
  annotations:
    cindy1.poc/io-weight: "100"
spec:
  schedulerName: ioi-scheduler
  restartPolicy: Never
  activeDeadlineSeconds: 120
  containers:
    - name: inert
      image: busybox:1.36
      command: ["sleep", "100"]
