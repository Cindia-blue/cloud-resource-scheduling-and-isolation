# Symmetric control cell: app-a and app-b both request io.weight=100 on
# the same node/device. 100:100 is a valid symmetric control, not an
# error -- it proves the controller-engaged path end to end without
# claiming a differentiated effect (see docs/limitations.md).
#
# Both Pods are pinned by spec.nodeName, not scheduled by the optional
# secondary scheduler in ../scheduler-optional/ -- a Pod with nodeName
# pre-set is bound directly by the kubelet, bypassing all schedulers
# regardless of spec.schedulerName. This is a deliberate node-rotation-
# safety property (see docs/experiment-runbook.md), not scheduler
# validation.
#
# Render this template first (see cmd/render-target); never apply it
# with __PLACEHOLDER__ tokens still present.
#
# The start-gate volume is a plain, non-privileged hostPath, not an
# emptyDir: /gate/start is written by the standalone gate-wait Pod
# (gate-wait-pod.yaml.tmpl), a code-enforced barrier that never depends
# on the adapter process being healthy. It independently polls the local
# cgroup filesystem until it proves controller-ready state plus this
# exact Pod's own materialized io.weight override, then writes this
# file itself -- see docs/experiment-runbook.md and
# pkg/iocostadapter/gate.go. Apply gate-wait-pod.yaml.tmpl after these
# Pods exist (it needs their live Pod UIDs) to actually release fio.
#
# Bounded workload shape: randwrite, 4k blocks, libaio/iodepth=16/
# direct=1, a 1GiB reusable working region capped at 2GiB cumulative
# I/O, rate-capped at 16000 IOPS, and a 30s runtime cap with no
# time_based looping past the cumulative cap. Pod-level
# activeDeadlineSeconds must exceed gate-wait's own GATE_TIMEOUT plus
# the fio runtime -- this template uses 90s (60s gate-wait timeout + 30s
# fio runtime + margin).
apiVersion: v1
kind: Pod
metadata:
  name: iocost-app-a
  namespace: {{TARGET_NAMESPACE}}
  labels:
    iocost.poc/cell: symmetric-100-100
    iocost.poc/role: app-a
  annotations:
    iocost.poc/io-weight: "100"
spec:
  restartPolicy: Never
  activeDeadlineSeconds: 90
  nodeName: __NODE_NAME__
  containers:
    - name: fio-antagonist
      image: "{{FIO_IMAGE}}"
      command: ["/bin/sh", "-c"]
      args:
        - |
          while [ ! -f /gate/start ]; do sleep 1; done
          fio --name=app-a --rw=randwrite --bs=4k --ioengine=libaio --iodepth=16 --direct=1 \
              --size=1073741824 --io_size=2147483648 --rate_iops=16000 --runtime=30 \
              --output-format=json --directory=/data | tee /gate/fio-result.json
          rc=$?
          touch /gate/done
          while [ ! -f /gate/stop ]; do sleep 1; done
          exit "$rc"
      volumeMounts:
        - name: data
          mountPath: /data
        - name: start-gate
          mountPath: /gate
  volumes:
    - name: data
      emptyDir: {}
    - name: start-gate
      hostPath:
        path: /tmp/iocost-gate/{{CELL_ID}}/app-a
        type: DirectoryOrCreate
---
apiVersion: v1
kind: Pod
metadata:
  name: iocost-app-b
  namespace: {{TARGET_NAMESPACE}}
  labels:
    iocost.poc/cell: symmetric-100-100
    iocost.poc/role: app-b
  annotations:
    iocost.poc/io-weight: "100"
spec:
  restartPolicy: Never
  activeDeadlineSeconds: 90
  nodeName: __NODE_NAME__
  containers:
    - name: fio-antagonist
      image: "{{FIO_IMAGE}}"
      command: ["/bin/sh", "-c"]
      args:
        - |
          while [ ! -f /gate/start ]; do sleep 1; done
          fio --name=app-b --rw=randwrite --bs=4k --ioengine=libaio --iodepth=16 --direct=1 \
              --size=1073741824 --io_size=2147483648 --rate_iops=16000 --runtime=30 \
              --output-format=json --directory=/data | tee /gate/fio-result.json
          rc=$?
          touch /gate/done
          while [ ! -f /gate/stop ]; do sleep 1; done
          exit "$rc"
      volumeMounts:
        - name: data
          mountPath: /data
        - name: start-gate
          mountPath: /gate
  volumes:
    - name: data
      emptyDir: {}
    - name: start-gate
      hostPath:
        path: /tmp/iocost-gate/{{CELL_ID}}/app-b
        type: DirectoryOrCreate
