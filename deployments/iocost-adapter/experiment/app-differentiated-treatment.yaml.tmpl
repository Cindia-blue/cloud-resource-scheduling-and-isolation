# Differentiated treatment cell: app-a requests io.weight=300, app-b
# keeps the inherited-default-looking io.weight=100. Run this only
# after a symmetric-100-100 cell has completed and been fully cleaned
# up on the SAME node/device -- see docs/experiment-runbook.md. Do not
# call an io.weight=100 readback alone a treatment: it is only
# meaningful relative to the completed symmetric baseline on the same
# device (see docs/limitations.md).
#
# Both Pods are pinned by spec.nodeName, not scheduled by the optional
# secondary scheduler in ../scheduler-optional/ -- a Pod with nodeName
# pre-set is bound directly by the kubelet, bypassing all schedulers
# regardless of spec.schedulerName. This is a deliberate node-rotation-
# safety property (see docs/experiment-runbook.md), not scheduler
# validation.
#
# Render this template first (see cmd/render-target); never apply it
# with __PLACEHOLDER__ tokens still present.
#
# The gate-wait initContainer (cmd/gate-wait) is the code-enforced
# workload-start barrier: it independently polls the local cgroup
# filesystem -- never the adapter process or its logs -- until it proves
# the target device's controller state is ready AND this exact Pod's own
# resolved cgroup already carries the expected io.weight override, then
# and only then writes /gate/start. It never depends on the adapter being
# healthy, and it fails closed on GATE_TIMEOUT without ever writing the
# start file, so a stalled adapter produces a Pod that never runs fio
# instead of one that runs fio against unproven state (see
# docs/experiment-runbook.md and pkg/iocostadapter/gate.go).
#
# Bounded workload shape: randwrite, 4k blocks, libaio/iodepth=16/
# direct=1, a 1GiB reusable working region capped at 2GiB cumulative
# I/O, rate-capped at 16000 IOPS, and a 30s runtime cap with no
# time_based looping past the cumulative cap. Pod-level
# activeDeadlineSeconds must exceed GATE_TIMEOUT plus the fio runtime --
# this template uses 90s (60s gate-wait timeout + 30s fio runtime +
# margin), wider than the 45s used before the barrier existed, since the
# barrier itself now consumes part of the deadline budget.
apiVersion: v1
kind: Pod
metadata:
  name: iocost-app-a
  namespace: {{TARGET_NAMESPACE}}
  labels:
    iocost.poc/cell: differentiated-300-100
    iocost.poc/role: app-a
  annotations:
    iocost.poc/io-weight: "300"
spec:
  restartPolicy: Never
  activeDeadlineSeconds: 90
  nodeName: __NODE_NAME__
  initContainers:
    - name: gate-wait
      image: "{{ADAPTER_IMAGE}}"
      command: ["/usr/local/bin/gate-wait"]
      securityContext:
        privileged: true
        readOnlyRootFilesystem: true
      env:
        - name: GATE_CGROUP_ROOT
          value: /sys/fs/cgroup
        - name: GATE_DEVICE
          value: __DEVICE_MAJMIN__
        - name: GATE_EXPECTED_WEIGHT
          valueFrom:
            fieldRef:
              fieldPath: metadata.annotations['iocost.poc/io-weight']
        - name: GATE_POD_UID
          valueFrom:
            fieldRef:
              fieldPath: metadata.uid
        - name: GATE_TIMEOUT
          value: "60s"
      volumeMounts:
        - name: cgroup
          mountPath: /sys/fs/cgroup
          readOnly: true
        - name: start-gate
          mountPath: /gate
  containers:
    - name: fio-antagonist
      image: "{{FIO_IMAGE}}"
      command: ["/bin/sh", "-c"]
      args:
        - |
          while [ ! -f /gate/start ]; do sleep 1; done
          fio --name=app-a --rw=randwrite --bs=4k --ioengine=libaio --iodepth=16 --direct=1 \
              --size=1073741824 --io_size=2147483648 --rate_iops=16000 --runtime=30 \
              --output-format=json --directory=/data | tee /gate/fio-result.json
          rc=$?
          touch /gate/done
          while [ ! -f /gate/stop ]; do sleep 1; done
          exit "$rc"
      volumeMounts:
        - name: data
          mountPath: /data
        - name: start-gate
          mountPath: /gate
  volumes:
    - name: data
      emptyDir: {}
    - name: start-gate
      emptyDir: {}
    - name: cgroup
      hostPath:
        path: /sys/fs/cgroup
        type: Directory
---
